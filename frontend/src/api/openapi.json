  },
  "components": {
    "schemas": {
      "CodeRequest": {
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 16,
            "title": "Code"
          }
        },
        "type": "object",
        "required": [
          "code"
        ],
        "title": "CodeRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "database": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Database"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "database"
        ],
        "title": "HealthResponse"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 1024,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest"
      },
      "LoginResult": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "authenticated",
              "mfa_required",
              "mfa_setup_required"
            ],
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "LoginResult"
      },
      "MfaRequest": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 16
              },
              {
                "type": "null"
              }
            ],
            "title": "Code"
          },
          "recovery_code": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 32
              },
              {
                "type": "null"
              }
            ],
            "title": "Recovery Code"
          }
        },
        "type": "object",
        "title": "MfaRequest"
      },
      "PasskeyAssertion": {
        "properties": {
          "challenge_id": {
            "type": "string",
            "format": "uuid",
            "title": "Challenge Id"
          },
          "credential": {
            "additionalProperties": true,
            "type": "object",
            "title": "Credential"
          }
        },
        "type": "object",
        "required": [
          "challenge_id",
          "credential"
        ],
        "title": "PasskeyAssertion"
      },
      "PasskeyOptions": {
        "properties": {
          "challenge_id": {
            "type": "string",
            "format": "uuid",
            "title": "Challenge Id"
          },
          "options": {
            "additionalProperties": true,
            "type": "object",
            "title": "Options"
          }
        },
        "type": "object",
        "required": [
          "challenge_id",
          "options"
        ],
        "title": "PasskeyOptions"
      },
      "PasskeyOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "last_used_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Used At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "created_at",
          "last_used_at"
        ],
        "title": "PasskeyOut"
      },
      "PasskeyRegistration": {
        "properties": {
          "challenge_id": {
            "type": "string",
            "format": "uuid",
            "title": "Challenge Id"
          },
          "credential": {
            "additionalProperties": true,
            "type": "object",
            "title": "Credential"
          },
          "name": {
            "type": "string",
            "maxLength": 60,
            "minLength": 1,
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "challenge_id",
          "credential",
          "name"
        ],
        "title": "PasskeyRegistration"
      },
      "Preferences": {
        "properties": {
          "currency": {
            "type": "string",
            "enum": [
              "EUR",
              "USD",
              "GBP",
              "CHF"
            ],
            "title": "Currency"
          },
          "month_start_day": {
            "type": "integer",
            "maximum": 28.0,
            "minimum": 1.0,
            "title": "Month Start Day"
          },
          "theme": {
            "type": "string",
            "enum": [
              "system",
              "light",
              "dark"
            ],
            "title": "Theme"
          },
          "language": {
            "type": "string",
            "const": "es",
            "title": "Language"
          }
        },
        "type": "object",
        "required": [
          "currency",
          "month_start_day",
          "theme",
          "language"
        ],
        "title": "Preferences"
      },
      "PreferencesUpdate": {
        "properties": {
          "currency": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "EUR",
                  "USD",
                  "GBP",
                  "CHF"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Currency"
          },
          "month_start_day": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 28.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Month Start Day"
          },
          "theme": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "system",
                  "light",
                  "dark"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Theme"
          },
          "language": {
            "anyOf": [
              {
                "type": "string",
                "const": "es"
              },
              {
                "type": "null"
              }
            ],
            "title": "Language"
          }
        },
        "type": "object",
        "title": "PreferencesUpdate"
      },
      "RecoveryCodes": {
        "properties": {
          "codes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Codes"
          }
        },
        "type": "object",
        "required": [
          "codes"
        ],
        "title": "RecoveryCodes"
      },
      "RegisterRequest": {
        "properties": {
          "display_name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Display Name"
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 1024,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "display_name",
          "email",
          "password"
        ],
        "title": "RegisterRequest"
      },
      "RegistrationStatus": {
        "properties": {
          "open": {
            "type": "boolean",
            "title": "Open"
          }
        },
        "type": "object",
        "required": [
          "open"
        ],
        "title": "RegistrationStatus"
      },
      "SessionOut": {
        "properties": {
          "level": {
            "type": "string",
            "enum": [
              "full",
              "mfa_pending",
              "mfa_setup"
            ],
            "title": "Level"
          },
          "user": {
            "$ref": "#/components/schemas/UserOut"
          }
        },
        "type": "object",
        "required": [
          "level",
          "user"
        ],
        "title": "SessionOut"
      },
      "TotpSetup": {
        "properties": {
          "secret": {
            "type": "string",
            "title": "Secret"
          },
          "otpauth_uri": {
            "type": "string",
            "title": "Otpauth Uri"
          },
          "qr_code": {
            "type": "string",
            "title": "Qr Code",
            "description": "SVG QR code as a data: URI"
          }
        },
        "type": "object",
        "required": [
          "secret",
          "otpauth_uri",
          "qr_code"
        ],
        "title": "TotpSetup"
      },
      "UserOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
