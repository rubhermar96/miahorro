    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "api:generate": "openapi-typescript src/api/openapi.json -o src/api/schema.d.ts",
    "icons": "pwa-assets-generator"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@tanstack/react-query": "^5.104.2",
