# Copy to .env for local development (outside Docker). Never commit .env.
MIAHORRO_ENVIRONMENT=development
MIAHORRO_DATABASE_URL=postgresql+psycopg://miahorro:miahorro@localhost:5432/miahorro
# At least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
MIAHORRO_SECRET_KEY=change-me-change-me-change-me-change-me
MIAHORRO_LOG_LEVEL=INFO
