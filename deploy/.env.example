# Production settings. Create the real file with ./init-env.sh (it generates the secrets).
# deploy/.env must never be committed; keep a copy of it in your password manager.

# Database password (letters and digits only, it goes inside a URL).
POSTGRES_PASSWORD=
# Encrypts second-factor secrets and keys recovery codes; at least 32 random characters.
MIAHORRO_SECRET_KEY=
# Open registration (the first account becomes the administrator). Set to false to close it,
# then run ./deploy.sh. MIAHORRO_MAX_USERS caps the number of accounts.
MIAHORRO_REGISTRATION_ENABLED=true
MIAHORRO_MAX_USERS=20
# iCloud link of the shared Apple Pay Shortcut (docs/uso.md, «Atajo compartido»). Empty: the app
# shows the guide to build it by hand.
MIAHORRO_SHORTCUT_URL=
# Local port the VPS's main proxy forwards miahorro.octogas.es to (127.0.0.1 only).
MIAHORRO_HTTP_PORT=8090

# Backups (backup.sh)
BACKUP_DIR=/var/backups/miahorro
BACKUP_PASSPHRASE_FILE=/etc/miahorro/backup-passphrase
# rclone destination for the off-site copy, e.g. gdrive:miahorro-backups (a dedicated folder:
# files older than 30 days in it are deleted). Leave empty to keep local copies only.
BACKUP_RCLONE_REMOTE=
